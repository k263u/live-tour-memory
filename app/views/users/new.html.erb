<section class="signup-page">
  <div class="signup-card">
    <p class="section-label">SIGN UP</p>

    <h1>ライブ遠征の思い出を、<br>ここから残そう。</h1>

    <p class="signup-description">
      Live Tour Memoryで、遠征の記録をひとつにまとめよう。
    </p>

    <% if @user.errors.any? %>
      <div class="form-errors">
         <ul>
         <% @user.errors.full_messages.each do |message| %>
           <li><%= message %></li>
    <% end %>
    </ul>
  </div>
<% end %>

    <%= form_with model: @user, class: "signup-form" do |f| %>
      <div class="form-group">
        <%= f.label :name, "名前" %>
        <%= f.text_field :name, placeholder: "お名前を入力" %>
      </div>

      <div class="form-group">
        <%= f.label :email, "メールアドレス" %>
        <%= f.email_field :email, placeholder: "example@example.com" %>
      </div>

      <div class="form-group">
        <%= f.label :password, "パスワード" %>
        <%= f.password_field :password, placeholder: "8文字以上" %>
      </div>

      <div class="form-group">
        <%= f.label :password_confirmation, "パスワード確認" %>
        <%= f.password_field :password_confirmation, placeholder: "もう一度入力" %>
      </div>

      <div class="signup-actions">
        <%= f.submit "新規登録 →", class: "primary-button signup-button" %>
      </div>
    <% end %>
  </div>
</section>