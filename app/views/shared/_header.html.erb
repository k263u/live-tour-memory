<header>
  <%= link_to root_path do %>
    <%= image_tag "logo.png", alt: "Live Tour Memory", class: "header-logo" %>
  <% end %>

  <nav>
    <% if logged_in? %>
      <%= link_to "ログアウト", user_session_path, data: { turbo_method: :delete } %>
    <% else %>
      <%= link_to "新規登録", new_user_path %>
      <%= link_to "ログイン", new_user_session_path %>
    <% end %>
  </nav>
</header>